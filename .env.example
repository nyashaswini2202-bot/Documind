# Copy this file to ".env" and fill in your values. Never commit ".env".

# --- LLM (answers + evaluation) -------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# auto = use Groq if a key is set, otherwise run in "extractive" mode (no LLM).
# Other values: groq | ollama | none
LLM_PROVIDER=auto
# Only needed when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Retrieval -----------------------------------------------------------
USE_RERANKER=true
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# --- Storage / limits ----------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=15
MAX_DOCS_PER_WORKSPACE=10
